    <string name="emergency_reports">आपातकालीन रिपोर्ट</string><string name="emergency_reports_description">इस डिवाइस पर सहेजी गई। BLE से भेजने के लिए पास के पीयर से कनेक्ट करें। परिवहन स्वीकृति का अर्थ प्रतिक्रियाकर्ता की स्वीकृति नहीं है।</string><string name="offline_location">ऑफ़लाइन स्थान</string><string name="create_emergency">आपातकाल बनाएँ</string><string name="no_saved_emergencies">अभी कोई स्थानीय आपातकाल सहेजा नहीं गया है।</string><string name="accuracy_age">सटीकता: %1$s · आयु: %2$s</string><string name="not_reported">रिपोर्ट नहीं किया गया</string><string name="location_source">स्रोत: %1$s</string><string name="approximate_permission">अनुमानित अनुमति</string><string name="getting_fix">स्थान प्राप्त हो रहा है…</string><string name="refresh_location">स्थान ताज़ा करें</string><string name="clear">साफ़ करें</string><string name="received_from_peer">पास के पीयर से प्राप्त</string><string name="details">विवरण</string><string name="send">भेजें</string><string name="sending">भेजा जा रहा है…</string><string name="acknowledged">स्वीकृत</string><string name="retry">पुनः प्रयास</string><string name="ready_to_send">पीयर कनेक्ट होने पर भेजने के लिए तैयार।</string><string name="sending_ble">सक्रिय BLE कनेक्शन पर भेजा जा रहा है…</string><string name="transport_acknowledged_explanation">परिवहन स्वीकृत। इसका अर्थ यह नहीं कि किसी प्रतिक्रियाकर्ता ने इसे स्वीकार किया।</string><string name="transmission_failed_local">प्रसारण विफल। रिपोर्ट स्थानीय रूप से सहेजी हुई है।</string><string name="connection_lost_retry">कनेक्शन खो गया। पीयर फिर कनेक्ट होने पर पुनः प्रयास करें।</string>
