    <string name="welcome_badge">स्थानीय प्राथमिकता वाला आपातकालीन नेटवर्क</string><string name="welcome_tagline">जब बुनियादी ढाँचा और कनेक्टिविटी विफल हो जाए, तब समुदाय-आधारित आपातकालीन समन्वय।</string><string name="welcome_start_profile">स्थानीय प्रोफ़ाइल से शुरू करें</string><string name="welcome_no_account">इस प्रोटोटाइप के लिए खाते या इंटरनेट की आवश्यकता नहीं है। आपकी स्वयं घोषित प्रोफ़ाइल इसी डिवाइस पर रहती है।</string><string name="get_started">शुरू करें</string><string name="welcome_disclaimer">यह समन्वय के लिए है, प्रमाण-पत्र सत्यापन के लिए नहीं। केवल वही जानकारी साझा करें जिसे आप स्थानीय रूप से घोषित करना चाहते हैं।</string>
    <string name="back">वापस</string><string name="create_local_profile">अपनी स्थानीय प्रोफ़ाइल बनाएँ</string><string name="edit_local_profile">अपनी स्थानीय प्रोफ़ाइल संपादित करें</string><string name="profile_setup_description">इससे आसपास के लोग समझ सकेंगे कि आप इस प्रोटोटाइप में कैसे भाग लेना चाहते हैं।</string><string name="self_declared_title">महत्वपूर्ण: स्वयं घोषित जानकारी</string><string name="self_declared_description">आपका नाम, भूमिका और क्षमताएँ सत्यापित प्रमाणीकरण या पेशेवर योग्यता का प्रमाण नहीं हैं। इसे प्रमाण-पत्र या विश्वास स्कोर न समझें।</string><string name="display_name">प्रदर्शित नाम</string><string name="display_name_hint">दूसरे आपको किस नाम से देखें?</string><string name="display_name_required">जारी रखने के लिए नाम दर्ज करें।</string><string name="choose_role">भूमिका चुनें</string><string name="role_not_verified">यह स्थानीय, स्वयं वर्णित भूमिका है और सत्यापित नहीं है।</string><string name="role_required">जारी रखने के लिए भूमिका चुनें।</string><string name="capabilities_optional">क्षमताएँ (वैकल्पिक)</string><string name="capabilities_hint">जैसे प्राथमिक उपचार, परिवहन, अनुवाद</string><string name="capabilities_help">वैकल्पिक और स्वयं घोषित। कई क्षमताओं को अल्पविराम से अलग करें।</string><string name="continue_label">जारी रखें</string><string name="save_profile">प्रोफ़ाइल सहेजें</string><string name="local_profile_disclaimer">इस चरण में केवल इस डिवाइस की स्थानीय प्रोफ़ाइल सहेजी जाती है। कोई खाता या क्लाउड सिंक नहीं है।</string>
    <string name="offline_emergency_coordination">ऑफ़लाइन आपातकालीन समन्वय</string><string name="welcome_user">स्वागत है, %1$s</string><string name="instant_sos_accessibility">तुरंत SOS। आपातकाल को स्थानीय रूप से सहेजें और कतार में रखें।</string><string name="sos_saved_undo">SOS सहेजा और कतार में रखा गया। 5 सेकंड में वापस लें।</string><string name="undo">वापस लें</string><string name="network">नेटवर्क</string><string name="offline">ऑफ़लाइन</string><string name="connected">कनेक्टेड</string><string name="nearby_peers">पास के पीयर</string><string name="saved_sos">सहेजे गए SOS</string><string name="ready_when_you_are">जब आप तैयार हों</string><string name="home_description">स्थानीय आपातकालीन रिपोर्ट बनाएँ या नागपुर का बंडल किया गया मानचित्र देखें। रिपोर्ट स्थानीय रहती हैं, जब तक आप उन्हें कनेक्टेड पीयर को न भेजें।</string><string name="report_emergency">आपातकाल रिपोर्ट करें</string><string name="open_map">मानचित्र खोलें</string><string name="safety_hub">सुरक्षा केंद्र</string><string name="recent_emergencies">हाल की आपातस्थितियाँ</string><string name="no_emergencies_saved">इस डिवाइस पर अभी कोई आपातस्थिति सहेजी नहीं गई है।</string>
