    <string name="safety_hub_description">व्यक्तिगत सुरक्षा उपकरण ऑफ़लाइन काम करते हैं। SOS पहले स्थानीय रूप से सहेजा जाता है और केवल BLE डिलीवरी प्रमाण के बाद परिवहन किया हुआ माना जाता है।</string><string name="discreet_sos_title">गोपनीय SOS</string><string name="discreet_sos_description">यह ऐप के भीतर गोपनीय कार्रवाई है, गुप्त निगरानी नहीं। स्पष्ट उपयोगकर्ता सेटअप आवश्यक है और लगातार सुनना नहीं होता।</string><string name="enable_discreet_action">गोपनीय कार्रवाई सक्षम करें</string><string name="safety_timer_checkin">सुरक्षा टाइमर और चेक-इन</string><string name="timer_status">स्थिति: %1$s</string><string name="time_remaining">शेष समय: %1$d मि %2$d से</string><string name="checkin_time_reached">चेक-इन समय पहुँच गया</string><string name="journey_label">यात्रा या गतिविधि का नाम</string><string name="checkin_interval">चेक-इन अंतराल मिनटों में</string><string name="ask_before_sos">चेक-इन छूटने पर SOS से पहले पूछें</string><string name="i_am_safe">मैं सुरक्षित हूँ</string><string name="create_safety_sos">सुरक्षा SOS बनाएँ</string><string name="trusted_contacts">विश्वसनीय संपर्क</string><string name="contacts_local_only">संपर्क स्थानीय रूप से सहेजे जाते हैं और स्वतः प्रसारित नहीं होते।</string><string name="contact_alias">संपर्क उपनाम</string><string name="optional_phone_detail">वैकल्पिक फ़ोन या संपर्क विवरण</string><string name="add_contact">संपर्क जोड़ें</string><string name="edit_contact">संपर्क संपादित करें</string><string name="remove">हटाएँ</string><string name="timer_inactive">निष्क्रिय</string><string name="timer_active">सक्रिय</string><string name="timer_due">देय</string><string name="timer_missed">छूटा हुआ</string><string name="timer_completed">पूर्ण</string>
    <string name="profile">प्रोफ़ाइल</string><string name="role_value">भूमिका: %1$s</string><string name="capabilities_value">क्षमताएँ: %1$s</string><string name="edit_profile">प्रोफ़ाइल संपादित करें</string><string name="theme">थीम</string><string name="theme_description">चुनें कि इस डिवाइस पर RESQMesh कैसा दिखे।</string><string name="accessibility_assistance">सुलभता और सहायता</string><string name="accessibility_description">ये विकल्प आपातकालीन कार्रवाइयों को देखना, सुनना और पूरा करना आसान बनाते हैं।</string><string name="high_contrast">उच्च कॉन्ट्रास्ट</string><string name="large_text">बड़ा टेक्स्ट</string><string name="simplified_mode">सरल आपातकाल मोड</string><string name="spoken_feedback">बोली गई आपातकालीन प्रतिक्रिया</string><string name="reduced_motion">कम गति</string><string name="language_description">आपातकालीन शब्दावली अंग्रेज़ी, हिंदी या मराठी में दिखाई जा सकती है। उपयोगकर्ता के लिखे विवरण का अनुवाद नहीं होता।</string><string name="local_data_description">इस चरण में प्रोफ़ाइल, आपातस्थिति, थीम और मानचित्र डेटा इसी डिवाइस पर स्थानीय रहते हैं।</string>
